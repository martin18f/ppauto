{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/ponuka",
      "destination": "/ponuka.html?brand=all"
    },
    {
      "source": "/subaru",
      "destination": "/ponuka.html?brand=subaru"
    },
    {
      "source": "/kgm",
      "destination": "/ponuka.html?brand=kgm"
    },
    {
      "source": "/jeep",
      "destination": "/ponuka.html?brand=jeep"
    },
    {
      "source": "/chery",
      "destination": "/ponuka.html?brand=chery"
    },
    {
      "source": "/auta/:id",
      "destination": "/auto.html?id=:id"
    }
  ]
}
