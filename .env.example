# PP AUTO - required Vercel environment variables
# Copy to .env.production.local and fill secrets locally.

GITHUB_TOKEN=
GITHUB_REPO=martin18f/ppauto
GITHUB_BRANCH=main
DATA_PATH=data/auta.json
OPTIONS_PATH=data/parametre.json
PROMOS_PATH=data/akcie.json
DOCUMENTS_PATH=data/dokumenty.json
VEHICLE_OPTIONS_PATH=data/vehicle-options.json

# Optional: otherwise GITHUB_* is used.
DATA_GITHUB_TOKEN=
DATA_GITHUB_REPO=
DATA_GITHUB_BRANCH=

ADMIN_KEY=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_SECONDS=28800

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=adminppauto@gmail.com
SMTP_PASS=
MAIL_FROM_ADDRESS=adminppauto@gmail.com
MAIL_FROM_NAME=PP AUTO
MAIL_REPLY_TO=adminppauto@gmail.com
MAIL_TO_DEFAULT=
MAIL_TO_ORDERS=
MAIL_TO_CONTACT=
MAIL_TO_FINANCE=
MAIL_TO_TESTDRIVE=
MAIL_SEND_CUSTOMER_CONFIRMATIONS=true
MAIL_ENABLED=true

ORDERS_GITHUB_TOKEN=
ORDERS_GITHUB_REPO=
ORDERS_GITHUB_BRANCH=main
ORDER_REQUESTS_PATH=data/orders.enc.json
ORDERS_ENCRYPTION_KEY=
ALLOW_PLAINTEXT_ORDER_MIGRATION=false

ALLOWED_ORIGINS=https://ppauto.sk,https://www.ppauto.sk
